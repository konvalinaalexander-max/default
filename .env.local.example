# Kopiere diese Datei zu ".env.local" und trage deine Werte ein.
# .env.local wird nie eingecheckt (siehe .gitignore).

# Aus der Sheet-URL: https://docs.google.com/spreadsheets/d/DIESER_TEIL/edit
GOOGLE_SHEET_ID=

# Die Namen der Tabellenblätter sind fest eingebaut und brauchen keine Variable:
# "Ertragsjournal", "Anbauplanung Ertrag" und "Referenzwerte".
# Eine noch gesetzte GOOGLE_SHEET_TAB_NAME wird ignoriert.

# Schreibweise des Datums im Sheet. Standard "de" schreibt 17.08.2026.
# Nur auf "iso" umstellen, wenn das Sheet auf eine englische Region eingestellt ist
# und dort 2026-08-17 erwartet wird.
GOOGLE_SHEET_DATE_FORMAT=de

# Aus der JSON-Datei des Service Accounts (Google Cloud Console):
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Den kompletten "private_key"-Wert aus der JSON-Datei, inkl. -----BEGIN PRIVATE KEY-----.
# Zeilenumbrüche als \n belassen (nicht durch echte Umbrüche ersetzen).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
